# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Server-only. Never reference these from frontend code.
# Put a database name after ".net/" (e.g. /sports-academy), otherwise MongoDB uses "test".
MONGODB_URI=your_mongodb_connection_string

# Signs session cookies. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out.
AUTH_SECRET=replace_with_at_least_32_random_characters

# Development only: password given to the demo accounts created by `npm run seed`.
SEED_PASSWORD=choose_a_dev_password

# Evaluation mode (competition judging only). When "true", the sign-in and sign-up
# pages show the demo academy's join codes and the demo logins (SEED_PASSWORD)
# for copy-paste. Set to "false" (or remove) after judging to keep them secret.
# MONGODB_URI and AUTH_SECRET are never shown.
EVALUATION_MODE=false
# Academy whose join codes are shown (default "Demo Academy", created by npm run seed).
EVALUATION_ACADEMY_NAME=Demo Academy

# Public values (exposed to the browser).
NEXT_PUBLIC_APP_NAME=Sports Academy
NEXT_PUBLIC_APP_URL=http://localhost:3000
