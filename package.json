{
  "name": "sports-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Sports Academy Management System - one integrated Next.js application",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file=.env.local --import ./scripts/register-alias.mjs scripts/seed.mjs",
    "migrate:academy": "node --env-file=.env.local --import ./scripts/register-alias.mjs scripts/migrate-academy.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "mongoose": "^9.11.4",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.12"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
